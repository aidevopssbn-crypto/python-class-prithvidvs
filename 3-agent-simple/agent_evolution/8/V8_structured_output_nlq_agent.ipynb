   "source": [
    "# Version 8 — Structured Output NLQ Agent\n",
    "\n",
    "This notebook demonstrates returning a fixed structured answer contract to a supervisor or caller.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from typing import Literal\n",
    "\n",
    "class QueryAnswer:\n",
    "    def __init__(self, answer: str, status: Literal['ok', 'unknown'], sql: str | None = None):\n",
    "        self.answer = answer\n",
    "        self.status = status\n",
    "        self.sql = sql\n",
    "\n",
    "result = QueryAnswer('42 orders were cancelled', 'ok', 'SELECT COUNT(*) FROM orders WHERE status = \'cancelled\'')\n",
    "print(result.answer, result.status, result.sql)\n"
   ]
  }
